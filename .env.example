APP_NAME=EntreGO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

GOOGLE_MAPS_API_KEY=sua_chave_aqui

# Locale em PT-BR (corrige textos default em inglês)
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

# ==============================================================================
# PERFORMANCE — VALORES PARA DESENVOLVIMENTO
# ==============================================================================
# Em PRODUÇÃO use:
#   BCRYPT_ROUNDS=12     (mais seguro contra brute force)
#   LOG_LEVEL=warning    (reduz I/O síncrono em arquivo)
#   SESSION_DRIVER=redis (ou file, se não tiver redis)
#   CACHE_STORE=redis
# ==============================================================================

# Hash de senha: 10 = ~60-120ms / 12 = ~250-500ms por login
# 10 é o padrão histórico do Laravel; aceitável em dev.
BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# 'warning' em dev evita o spam de logs DEBUG/INFO que freia o login.
# Suba pra 'debug' apenas quando estiver investigando algum problema.
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# 'file' em dev evita 2-3 queries extras por request (sessions na DB).
# Em prod com múltiplos servidores web, troque pra 'redis' ou 'database'.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
